<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="1">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/main_toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="?attr/colorPrimary"
      android:elevation="4dp"
      android:theme="@style/ThemeOverlay.AppCompat.ActionBar"/>

  <ScrollView
      xmlns:android="http://schemas.android.com/apk/res/android"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:id="@+id/topScroll" >

    <LinearLayout
        android:orientation="vertical"
        android:gravity="top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:background="#000000">

      <TextView
          android:id="@+id/playlist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:focusable="true"
          android:text="@string/null_playlist"
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"
          android:weightSum="1"/>

      <!-- WORKAROUND: the player controls keep disappearing because
           it thinks it's displaying video, so we set the height; good
           for my phone/tablet -->

      <!-- 150 dp; only shows play/pause -->
      <!-- 200 dp; shows all. -->
      <!-- hide_on_touch, auto_show have no effect -->
      <androidx.media3.ui.PlayerView
          android:id="@+id/player_view"
          android:layout_width="match_parent"
          android:layout_height="200dp"
          android:visibility="visible"
          android:gravity="center"
          app:use_controller="true"
          app:show_shuffle_button="false"
          app:show_subtitle_button="false"
          app:keep_content_on_player_reset="true"
          app:show_buffering="always"
          app:show_vr_button="false"
          app:use_artwork="true"
          app:hide_on_touch="true"
          app:auto_show="false"/>

      <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/image_slideshow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

      <!-- year
           composer
           album artist
           artists
           album
           title
           category
           notes buttons
      -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:id="@+id/year"
          android:text=""
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"/>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@android:color/white" />  <!-- separator -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:id="@+id/composer"
          android:text=""
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"/>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@android:color/white" />  <!-- separator -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:id="@+id/albumArtist"
          android:text=""
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"/>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@android:color/white" />  <!-- separator -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:id="@+id/artist"
          android:text=""
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"/>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@android:color/white" /> <!-- separator -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:id="@+id/album"
          android:text=""
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"/>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@android:color/white" /> <!-- separator -->
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text=""
          android:id="@+id/title"
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"/>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="#ffffffff"/> <!-- separator -->

      <androidx.compose.ui.platform.ComposeView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text=""
          android:id="@+id/category"
          android:textAppearance="?android:attr/textAppearanceLarge"
          android:background="@android:color/black"
          android:textColor="@android:color/white"/>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="#ffffffff"/> <!-- separator -->
      <LinearLayout
          style="?android:attr/buttonBarButtonStyle"
          android:id="@+id/notes_buttons_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_gravity="bottom"
          android:layout_marginTop="1dip"
          android:layout_marginBottom="2dip"
          android:gravity="center">
        <!-- SDK 20: can't use @string in textSize attribute, despite the documentation
             API 10: layout_height of wrap_content on buttons screws up; only last button will wrap text
        -->
        <!-- notes buttons, row 1
        -->
        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/note_category"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"
            android:text="@string/note_category"
            android:onClick="onClickNote"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" /> <!-- vertical separator -->
        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/note_dont_play"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"
            android:text="@string/note_dont_play"
            android:onClick="onClickNote"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" /> <!-- vertical separator -->
        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/note_play_before"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"
            android:text="@string/note_play_before"
            android:onClick="onClickNote"/>
      </LinearLayout>
      <LinearLayout
          style="?android:attr/buttonBarButtonStyle"
          android:id="@+id/notes_buttons_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_gravity="center"
          android:layout_marginTop="1dip"
          android:layout_marginBottom="2dip"
          android:gravity="center">

        <!-- notes buttons, row 2
             text color broken on Galaxy Note 3 Android 5.0 upgrade
        -->
        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/note_want_more"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"
            android:text="@string/note_want_more"
            android:onClick="onClickNote"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" /> <!-- vertical separator -->
        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/note_best_list"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"
            android:text="@string/note_best_list"
            android:onClick="onClickNote"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" /> <!-- vertical separator -->
        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/note_other"
            android:layout_height="match_parent"
            android:layout_width="wrap_content"
            android:text="@string/note_other"
            android:onClick="onClickNote"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
